# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# uv resolver lockfile: local environment setup only, not a project workflow
uv.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Testing
.coverage
htmlcov/
.pytest_cache/
coverage.xml

# Mypy
.mypy_cache/

# Ruff
.ruff_cache/

# Per-checkout extra denylist for the no-local-paths hook (machine-specific tokens)
scripts/.local-denylist

# Docker
.docker/

# Workspace data (never commit — mount at runtime)
/workspace/

# JSON defaults to ignored, except committed test fixtures
*.json
!tests/fixtures/*.json
!tests/fixtures/**/*.json

# --- collaboration artifacts: live in the Obsidian vault HQ, never in the code repo ---
/localdata/
.github/instructions/codacy.instructions.md
.agents/
.claude/
.gemini/
agent_reviews/
benchmark*
CLAUDE.md
GEMINI.md
CONVENTIONS.md
